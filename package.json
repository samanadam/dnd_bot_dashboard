{
  "name": "dnd_bot_dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "mock-bot": "node --env-file-if-exists=.env.local scripts/mock-bot.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node --env-file-if-exists=.env.local scripts/verify-bundle.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:mock": "docker compose -f docker-compose.yml -f compose.mock.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f compose.mock.yml down",
    "docker:host": "docker compose -f docker-compose.yml -f compose.host.yml up -d",
    "test:ops": "sh tests/ops/run.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}

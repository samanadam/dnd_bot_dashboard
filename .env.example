# Portal configuration for the VPS.
#
#   cp .env.example .env && chmod 600 .env
#
# Every value is read by the server at runtime and never reaches the browser.
# Never add a NEXT_PUBLIC_ prefix to any of them. Keep .env out of git (it is
# already in .gitignore and .dockerignore).

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# The HTTPS URL people open. The Caddy container (compose.caddy.yml) terminates
# TLS and forwards to the portal on 127.0.0.1:3000.
# The bare hostname, used by Caddy to request the certificate:
PORTAL_DOMAIN=dashboard.example.com
AUTH_URL=https://dashboard.example.com
# Trust X-Forwarded-* from that reverse proxy. Keep true behind a proxy you run.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Bot API (the recorder bot on the same VPS)
# ---------------------------------------------------------------------------
# Pick ONE of these, matching how the bot runs:
#
# a) Bot listens on the VPS's own loopback (bot run directly, or its container
#    publishes 127.0.0.1:8080). Start the portal with compose.host.yml.
BOT_API_URL=http://127.0.0.1:8080/api/v1
#
# b) Bot is a container on a Docker network the portal joins
#    (see the networks section in docker-compose.yml):
# BOT_API_URL=http://bot:8080/api/v1
# BOT_API_HTTP_HOSTS=bot
#
# c) Bot on another machine: HTTPS only, plain HTTP is refused.
# BOT_API_URL=https://bot.example.com/api/v1

# The bot's API_TOKEN. Full control of the bot, including deleting recordings.
BOT_API_TOKEN=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Generate a fresh one, never reuse it anywhere else:
#   openssl rand -base64 33
# Changing it signs everyone out.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Discord sign-in
# ---------------------------------------------------------------------------
# https://discord.com/developers/applications > your app > OAuth2
# Add this redirect URL there (same host as AUTH_URL):
#   https://dashboard.example.com/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Discord: Settings > Advanced > Developer Mode on, then right-click to copy ids.
# The campaign server (guild) id:
ALLOWED_GUILD_ID=
# Admin role id(s), comma-separated. Holding any one of them grants access.
ALLOWED_ROLE_IDS=

# Your own Discord user id (Developer Mode > right-click yourself > Copy User ID).
# Only these ids can open the DM Screen: bestiary, NPCs, combat and dice.
# Empty = nobody. Comma-separate to add a co-DM.
DM_USER_IDS=

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
# Image to run. Default is a locally built image; set this when pulling a
# prebuilt one (recommended on a small VPS, building needs ~1.5 GB RAM):
# PORTAL_IMAGE=ghcr.io/<github-user>/dnd-portal:latest
# Host port the portal binds on 127.0.0.1 (Caddy expects 3000):
# PORTAL_PORT=3000
# Compose files to use, so plain `docker compose up -d` does the right thing.
# (a) bot on the VPS's loopback:
COMPOSE_FILE=docker-compose.yml:compose.host.yml:compose.caddy.yml
# (b)/(c) otherwise:
# COMPOSE_FILE=docker-compose.yml:compose.caddy.yml
